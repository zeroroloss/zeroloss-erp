<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
	PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-config.dtd">

<!-- MyBatis 설정 파일 -->
<configuration>

    <!-- 1. typeAliases : DTO 클래스의 별칭(alias) 설정 -->
    <typeAliases>
        <!-- dto.DemoDto 클래스를 'DemoDto'라는 이름으로 매핑 -->
        <typeAlias type="dto.DemoDto" alias="DemoDto"/>
    </typeAliases>

    <!-- 2. environments : DB 환경 설정 -->
    <environments default="development">
        <environment id="development">

            <!-- 트랜잭션 매니저 설정 -->
            <!-- JDBC : MyBatis가 직접 Connection commit/rollback 관리 -->
            <transactionManager type="JDBC"/>

            <!-- 데이터소스 설정 -->
            <dataSource type="POOLED"> <!-- 커넥션 풀 사용 -->
                <!-- DB 드라이버 클래스 -->
                <property name="driver" value="org.mariadb.jdbc.Driver"/>
                <!-- DB URL -->
                <property name="url" value="jdbc:mariadb://localhost:3306/zeroloss"/>
                <!-- DB 계정 -->
                <property name="username" value="root"/>
                <property name="password" value="7564"/>

                <!-- 최대 활성 커넥션 수 : 동시에 사용 가능한 커넥션 수 -->
                <property name="poolMaximumActiveConnections" value="500"/>
                <!-- 최대 유휴 커넥션 수 : 풀에 유지될 수 있는 커넥션 수 -->
                <property name="poolMaximumIdleConnections" value="500"/>
            </dataSource>

        </environment>
    </environments>

    <!-- 3. mappers : MyBatis Mapper XML 파일 위치 -->
    <mappers>
        <!-- 추후 Mapper XML 파일 추가 필요 -->
    </mappers>

</configuration>