<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
	PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
	"http://mybatis.org//dtd/mybatis-3-config.dtd">
<configuration>
	<settings>
    	<setting name="mapUnderscoreToCamelCase" value="true"/>
	</settings>

	<environments default="development">
		<environment id="development">
			<transactionManager type="JDBC"/>
			<dataSource type="POOLED">
				<property name="driver" value="org.mariadb.jdbc.Driver"/>
				
			 	<!-- <property name="url" value="jdbc:mariadb://192.168.0.248:3306/zeroloss"/> -->  
				<property name="url" value="jdbc:mariadb://localhost:3306/zeroloss"/> 

				<property name="username" value="root"/>
				<property name="password" value="7564"/>
				<!-- 최대 활성 커넥션 수 : 동시에 사용할 수 있는 최대 커넥션 수-->
				<property name="poolMaximumActiveConnections" value="500"/>
				<!-- 최대 유효 커넥션 수 : 사용하지 않고 대기 상태를 유지할 커넥션 개수-->
				<property name="poolMaximumIdleConnections" value="500"/>
			</dataSource>
		</environment>
	</environments>
	
	<mappers>
		<mapper resource="mapper/AccountMapper.xml"/>
		<mapper resource="mapper/BranchMapper.xml"/>
        <mapper resource="mapper/DispatchMapper.xml"/>
        <mapper resource="mapper/NotificationMapper.xml"/>

		<mapper resource="mapper/hq/PlaceOrderQuantityLimitMapper.xml"/>
		<mapper resource="mapper/hq/PlaceOrderProcessingMapper.xml"/>
		<mapper resource="mapper/hq/place_order/PlaceOrderOverviewMapper.xml"/>
		<mapper resource="mapper/hq/EmployeeMapper.xml"/>
		<mapper resource="mapper/hq/HqScheduleMapper.xml"/>
		<mapper resource="mapper/hq/BranchOptionMapper.xml"/>
		<mapper resource="mapper/hq/WarehouseStockMapper.xml"/>
		<mapper resource="mapper/hq/warehouse/WarehouseOutboundMapper.xml"/>
        <mapper resource="mapper/hq/BranchStockMapper.xml"/>
        <mapper resource="mapper/hq/BranchRiskMapper.xml"/>
        <mapper resource="mapper/hq/BranchSearchMapper.xml"/>
        <mapper resource="mapper/hq/NoticeMapper.xml"/>
		<mapper resource="mapper/hq/ReceipeMapper.xml"/>
        <mapper resource="mapper/hq/sales/HqSalesMapper.xml"/>
        <mapper resource="mapper/hq/sales/SalesRankingMapper.xml"/>
        <mapper resource="mapper/hq/DeliveryMapper.xml"/>
        <mapper resource="mapper/hq/HqDispatchNotifiMapper.xml"/>

		<mapper resource="mapper/branch/EmployeeMapper.xml"/>
		<mapper resource="mapper/branch/BranchScheduleMapper.xml"/>
		<mapper resource="mapper/branch/InquiryMapper.xml"/>
		<mapper resource="mapper/branch/stock/BranchSafetyStockMapper.xml"/>
		<mapper resource="mapper/branch/place_order/PlaceOrderMapper.xml"/>
		<mapper resource="mapper/branch/place_order/PlaceOrderDraftMapper.xml"/>
		<mapper resource="mapper/branch/sales/SalesMapper.xml"/>
        <mapper resource="mapper/branch/sales/BranchSalesRankMapper.xml"/>
        <mapper resource="mapper/branch/stock/BranchStockListMapper.xml"/>
        <mapper resource="mapper/branch/stock/StockChangeHistoryMapper.xml"/>
		<mapper resource="mapper/branch/SwapMapper.xml"/>
		<mapper resource="mapper/branch/InboundMapper.xml"/>
		<mapper resource="mapper/branch/InboundHistoryMapper.xml"/>
	</mappers>
</configuration>
